page { background: #0D1117; }
.page { padding: 16px; max-width: 520px; margin: 0 auto; }
.room-id { text-align: center; margin-bottom: 16px; }
.room-label { font-size: 12px; color: #8B949E; }
.room-value { font-size: 24px; font-weight: 700; color: #4ECDC4; letter-spacing: 4px; }
.share-hint { text-align: center; margin-bottom: 16px; }
.share-btn { width: 80%; height: 48px; border-radius: 24px; background: linear-gradient(135deg, #07C160, #06AD56); border: none; color: white; font-size: 15px; font-weight: 600; line-height: 48px; }
.hint-text { font-size: 12px; color: #8B949E; margin-top: 8px; }
.seats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 16px; }
.seat-card { background: #161B22; border-radius: 16px; padding: 20px 12px; border: 2px solid #30363D; text-align: center; position: relative; }
.seat-badge { position: absolute; top: 8px; left: 8px; background: #FF6B35; color: white; font-size: 10px; padding: 2px 8px; border-radius: 8px; }
.seat-avatar { width: 44px; height: 44px; border-radius: 50%; margin: 0 auto 8px; }
.seat-avatar-text { font-size: 36px; display: block; margin-bottom: 8px; }
.seat-name { font-size: 14px; font-weight: 600; color: #FFF; }
.seat-status { font-size: 12px; color: #51CF66; margin-top: 6px; }
.seat-empty { text-align: center; padding: 20px 0; }
.seat-empty-icon { font-size: 36px; color: #30363D; display: block; }
.seat-empty-text { font-size: 12px; color: #8B949E; margin-top: 6px; }
.rules-card { background: #161B22; border-radius: 16px; padding: 16px; margin-bottom: 16px; border: 1px solid #30363D; }
.rules-title { font-size: 14px; font-weight: 600; color: #FFF; margin-bottom: 12px; }
.rules-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
.rule-item { display: flex; justify-content: space-between; padding: 6px 10px; background: rgba(255,255,255,0.03); border-radius: 8px; }
.rule-label { font-size: 13px; color: #8B949E; }
.rule-value { font-size: 13px; color: #4ECDC4; font-weight: 500; }
.start-btn { width: 100%; height: 52px; border-radius: 26px; background: linear-gradient(135deg, #FF6B35, #FF8F66); border: none; color: #FFF; font-size: 17px; font-weight: 600; line-height: 52px; margin-bottom: 30px; }
.start-btn.disabled { background: #30363D; color: #8B949E; text-align: center; line-height: 52px; }
.wait-text { text-align: center; font-size: 13px; color: #8B949E; margin-top: -16px; }
