page { background: #0D1117; }
.page { padding: 16px; max-width: 520px; margin: 0 auto; padding-bottom: 80px; }
.header { font-size: 20px; font-weight: 700; color: #FFF; text-align: center; padding: 16px 0; }
.card { background: #161B22; border-radius: 16px; padding: 16px; margin-bottom: 12px; border: 1px solid #30363D; }
.card-title { font-size: 15px; font-weight: 600; color: #FFF; margin-bottom: 12px; }
.rank-item, .player-card { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
.player-card { background: #161B22; border-radius: 12px; padding: 12px 16px; margin-bottom: 8px; border: 1px solid #30363D; }
.medal, .p-medal { font-size: 18px; width: 28px; }
.av, .p-av { font-size: 22px; }
.info, .p-info { flex: 1; }
.name, .p-name { font-size: 14px; font-weight: 600; color: #FFF; display: block; }
.pos, .p-pos { font-size: 11px; color: #8B949E; }
.score, .p-score { font-size: 17px; font-weight: 700; }
.score.pos, .p-score.pos { color: #51CF66; }
.score.neg, .p-score.neg { color: #FF6B6B; }
.stat-line { font-size: 13px; color: #8B949E; line-height: 1.6; }
.bottom-hint { text-align: center; font-size: 12px; color: #8B949E; margin: 16px 0; }
.home-btn { width: 100%; height: 50px; border-radius: 25px; background: linear-gradient(135deg, #FF6B35, #FF8F66); border: none; color: #FFF; font-size: 16px; font-weight: 600; line-height: 50px; }
