page { background: #0D1117; }
.page { padding: 0 0 100px; max-width: 520px; margin: 0 auto; }
.top-bar { background: #161B22; padding: 12px 16px; border-bottom: 1px solid #30363D; }
.round-text { font-size: 14px; color: #8B949E; margin-bottom: 8px; }
.players-bar { display: flex; gap: 6px; flex-wrap: wrap; }
.player-chip { display: flex; align-items: center; gap: 4px; padding: 6px 10px; border-radius: 10px; background: rgba(255,255,255,0.04); border: 1px solid #30363D; }
.player-chip.active { border-color: #FF6B35; background: rgba(255,107,53,0.12); }
.chip-avatar { font-size: 14px; }
.chip-name { font-size: 12px; color: #FFF; }
.chip-score { font-size: 12px; font-weight: 600; }
.chip-score.pos { color: #51CF66; }
.chip-score.neg { color: #FF6B6B; }

.voice-bar { display: flex; justify-content: center; padding: 10px 16px; }
.voice-btn { height: 40px; border-radius: 20px; padding: 0 24px; background: linear-gradient(135deg, #4ECDC4, #3DBDB5); border: none; color: white; font-size: 14px; font-weight: 600; line-height: 40px; }
.voice-btn.recording { background: linear-gradient(135deg, #FF6B6B, #FF4444); }
.voice-status { text-align: center; font-size: 12px; color: #8B949E; min-height: 18px; padding: 0 16px 4px; }

.section { padding: 12px 16px; }
.section-label { font-size: 14px; font-weight: 600; color: #FFF; margin-bottom: 10px; }
.flower-control { display: flex; align-items: center; justify-content: center; gap: 20px; }
.flower-btn { width: 44px; height: 44px; border-radius: 50%; background: #161B22; border: 1px solid #30363D; color: #FFF; font-size: 20px; line-height: 44px; text-align: center; padding: 0; }
.flower-value { font-size: 32px; font-weight: 700; color: #FF6B35; min-width: 40px; text-align: center; }

.pattern-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.pattern-btn { padding: 10px 16px; border-radius: 12px; background: #161B22; border: 1px solid #30363D; text-align: center; }
.pattern-btn.active { border-color: #FF6B35; background: rgba(255,107,53,0.12); }
.pattern-text { display: block; font-size: 14px; color: #FFF; }
.pattern-sub { display: block; font-size: 11px; color: #8B949E; margin-top: 2px; }

.dianpao-grid { display: flex; gap: 8px; flex-wrap: wrap; }
.dianpao-btn { padding: 8px 16px; border-radius: 10px; background: #161B22; border: 1px solid rgba(255,107,107,0.3); color: #FF6B6B; font-size: 13px; }
.dianpao-btn.active { background: rgba(255,107,107,0.15); border-color: #FF6B6B; }

.preview-bar { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: #161B22; border-top: 1px solid #30363D; }
.preview-text { font-size: 13px; color: #8B949E; }
.preview-value { font-size: 20px; font-weight: 700; color: #51CF66; }
.preview-value.pos { color: #51CF66; }

.confirm-btn { width: calc(100% - 32px); margin: 12px 16px; height: 48px; border-radius: 24px; background: linear-gradient(135deg, #FF6B35, #FF8F66); border: none; color: #FFF; font-size: 16px; font-weight: 600; line-height: 48px; }
.confirm-btn[disabled] { background: #30363D; color: #8B949E; }

.records-section { padding: 16px; }
.records-title { font-size: 14px; font-weight: 600; color: #FFF; margin-bottom: 10px; display: flex; justify-content: space-between; }
.record-item { display: flex; gap: 10px; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
.record-icon { font-size: 18px; }
.record-info { flex: 1; }
.record-desc { font-size: 13px; color: #FFF; display: block; }
.record-time { font-size: 11px; color: #8B949E; margin-top: 2px; display: block; }

.end-section { padding: 16px; }
.end-btn { width: 100%; height: 44px; border-radius: 22px; background: transparent; border: 1px solid rgba(255,107,107,0.5); color: #FF6B6B; font-size: 14px; font-weight: 600; line-height: 44px; }
