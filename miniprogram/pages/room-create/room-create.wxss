page { background: #0D1117; min-height: 100vh; }
.page { padding: 16px; max-width: 520px; margin: 0 auto; }
.card { background: #161B22; border-radius: 16px; padding: 20px; margin-bottom: 16px; border: 1px solid #30363D; }
.section-title { font-size: 16px; font-weight: 600; color: #FFF; margin-bottom: 16px; }
.form-item { display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
.form-item:last-child { border-bottom: none; }
.form-label { font-size: 14px; color: #8B949E; }
.form-control { flex-shrink: 0; }
.form-value { font-size: 15px; color: #4ECDC4; font-weight: 500; padding: 4px 12px; background: rgba(78,205,196,0.08); border-radius: 8px; }
.pattern-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.pattern-item { display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; border-radius: 10px; background: rgba(255,255,255,0.03); border: 1px solid #30363D; }
.pattern-name { font-size: 13px; color: #FFF; }
.pattern-control .form-value { font-size: 14px; padding: 2px 10px; }
.create-btn {
  width: 100%; height: 52px; border-radius: 26px; margin-top: 8px; margin-bottom: 30px;
  background: linear-gradient(135deg, #FF6B35, #FF8F66); border: none;
  color: #FFF; font-size: 17px; font-weight: 600; line-height: 52px;
}
